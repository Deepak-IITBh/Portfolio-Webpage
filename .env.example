# Contact form (server-side, via Resend: https://resend.com)
# Copy to .env for local development; set the same variables on your host. Never commit .env.

# Required: Resend API key (create one at https://resend.com/api-keys).
RESEND_API_KEY=

# Where messages are delivered.
CONTACT_TO_EMAIL=deepakde@iitbhilai.ac.in

# Sender shown on the email. "onboarding@resend.dev" works without a verified domain,
# but only delivers to the email address you signed up to Resend with. To send from your
# own domain, verify it in Resend and use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Production URL (canonical + Open Graph links).
SITE_URL=
